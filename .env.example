# ===========================================================================
# CampusPolicy AI — Environment Configuration Template
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Google Gemini API Configuration
# ---------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model: gemini-embedding-001 supports Matryoshka output dimension reduction
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Generative model: gemini-3.5-flash-lite provides fast, low-latency, strictly grounded inference
GEMINI_GENERATIVE_MODEL=models/gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# 2. Qdrant Vector Database Configuration
# ---------------------------------------------------------------------------
# Qdrant Cloud cluster endpoint (e.g., https://xxxx.sa-east-1-0.aws.cloud.qdrant.io:6333)
# Or for local development: http://localhost:6333
QDRANT_URL=https://your-cluster-url.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=campus_policies

# ---------------------------------------------------------------------------
# 3. Document Chunking & Ingestion Settings
# ---------------------------------------------------------------------------
# Section-aware chunk size (characters) and overlap
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Maximum allowed file upload size in bytes (20 MB = 20971520 bytes)
MAX_UPLOAD_SIZE_BYTES=20971520

# ---------------------------------------------------------------------------
# 4. Retrieval & Ranking Configuration
# ---------------------------------------------------------------------------
# Default number of top policy chunks retrieved for LLM context synthesis
TOP_K=5

# Default retrieval mode: 'baseline', 'hyde', or 'hyde_hybrid'
RETRIEVAL_METHOD=hyde_hybrid

# ---------------------------------------------------------------------------
# 5. Semantic Caching & Redis Configuration (Extension A)
# ---------------------------------------------------------------------------
# Redis connection URL. If Redis is unavailable, an in-memory cache fallback is used.
REDIS_URL=redis://localhost:6379/0

# Enable/disable semantic and exact query caching
ENABLE_SEMANTIC_CACHE=true

# Cosine similarity threshold (0.0 to 1.0) to trigger a semantic cache hit
SEMANTIC_CACHE_THRESHOLD=0.90

# Cache time-to-live in seconds (automatically invalidated upon policy upload/delete)
CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# 6. Application & Security Settings
# ---------------------------------------------------------------------------
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
